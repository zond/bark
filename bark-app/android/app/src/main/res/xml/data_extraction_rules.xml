<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app stores leaves the phone by itself (Android 12 and
     later): it holds the seed every key comes from, and an identity on two
     phones would spend each other's `sent`. The person moves it with the
     identity file (Settings). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
